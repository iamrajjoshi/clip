# Optional repository location used by the globally installed clip command.
CLIP_REPO=~/code/clip

# Sentry auth token for source map uploads during build.
# Create one at https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=

# Sentry client DSN for the web app. Public by design, since it is inlined into
# the browser bundle, but kept in env rather than hardcoded in source.
# Find it under Settings > Projects > clip > Client Keys (DSN).
# In CI this comes from the PUBLIC_SENTRY_DSN Actions variable.
PUBLIC_SENTRY_DSN=
