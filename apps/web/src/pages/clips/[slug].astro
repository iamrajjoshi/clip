---
import Base from "@/layouts/Base.astro";
import ClipCard from "@/components/ClipCard.astro";
import { getClipDescription, getClipSocialImage, getClipTitle, type ClipEntry } from "@/lib/clips";
import { getClipEntries } from "@/lib/content";

export async function getStaticPaths() {
  return (await getClipEntries()).map((clip) => ({ params: { slug: clip.slug }, props: { clip } }));
}

const { clip } = Astro.props as { clip: ClipEntry };
---

<Base title={getClipTitle(clip)} description={getClipDescription(clip)} image={getClipSocialImage(clip)}>
  <div class="permalink-nav"><a class="quiet-link" href="/">All clips</a><a class="quiet-link" href="/rss.xml">RSS</a></div>
  <ClipCard entry={clip} standalone />
</Base>
