---
import type { ClipEntry } from "@/lib/clips";
import CardShell from "@/components/cards/CardShell.astro";
import EntryBody from "@/components/EntryBody.astro";
import { formatDate } from "@/lib/clips";
import { linkifyText } from "@/lib/text";

const { entry, standalone = false } = Astro.props as { entry: ClipEntry; standalone?: boolean };
if (entry.data.kind !== "tweet") throw new Error("TweetCard received a non-tweet entry.");
const Heading = standalone ? "h1" : "h2";
---

<CardShell entry={entry} standalone={standalone}>
  <div class="post-author">
    {entry.data.author.avatar && <img class="author-avatar" src={entry.data.author.avatar} alt="" width="32" height="32" loading="lazy" />}
    <div class="post-byline">
      <Heading class="author-name"><a href={entry.data.url} rel="noreferrer">{entry.data.author.name}</a></Heading>
      <span class="author-handle">@{entry.data.author.handle}</span>
    </div>
  </div>
  <blockquote class="post-text"><p>{linkifyText(entry.data.text).map((part) => part.href ? <a href={part.href} rel="noreferrer">{part.text}</a> : part.text)}</p></blockquote>
  {entry.data.media?.length ? <div class:list={["post-media", { "post-media--multiple": entry.data.media.length > 1 }]}>{entry.data.media.map((media) => <a href={media.src} aria-label={media.alt || "Open saved image"}><img src={media.src} alt={media.alt ?? ""} loading="lazy" /></a>)}</div> : null}
  <div class="post-source">
    <a class="quiet-link" href={entry.data.url} rel="noreferrer">View post</a>
    {standalone && <time datetime={entry.data.postedAt.toISOString()}>Posted {formatDate(entry.data.postedAt)}</time>}
  </div>
  {entry.body?.trim() && <div slot="commentary" class="clip-commentary"><EntryBody entry={entry} /></div>}
</CardShell>
