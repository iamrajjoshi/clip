---
import type { ClipEntry } from "@/lib/clips";
import CardShell from "@/components/cards/CardShell.astro";
import EntryBody from "@/components/EntryBody.astro";

const { entry, standalone = false } = Astro.props as { entry: ClipEntry; standalone?: boolean };
if (entry.data.kind !== "video") throw new Error("VideoCard received a non-video entry.");
const Heading = standalone ? "h1" : "h2";
---

<CardShell entry={entry} standalone={standalone}>
  <div class="link-preview">
    <div class="link-copy">
      <p class="clip-source">{entry.data.channel || entry.data.provider}</p>
      <Heading class="clip-title"><a href={entry.data.url} rel="noreferrer">{entry.data.title}</a></Heading>
      <a class="quiet-link video-source" href={entry.data.url} rel="noreferrer">Watch on {entry.data.provider}</a>
    </div>
    {entry.data.thumbnail && <a class="link-thumbnail" href={entry.data.url} tabindex="-1" aria-hidden="true"><img src={entry.data.thumbnail} alt="" width="112" height="84" loading="lazy" /></a>}
  </div>
  {entry.body?.trim() && <div slot="commentary" class="clip-commentary"><EntryBody entry={entry} /></div>}
</CardShell>
