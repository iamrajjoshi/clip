---
import type { ClipEntry } from "@/lib/clips";
import CardShell from "@/components/cards/CardShell.astro";
import EntryBody from "@/components/EntryBody.astro";

const { entry, standalone = false } = Astro.props as { entry: ClipEntry; standalone?: boolean };
if (entry.data.kind !== "image") throw new Error("ImageCard received a non-image entry.");
const Heading = standalone ? "h1" : "h2";
---

<CardShell entry={entry} standalone={standalone}>
  <Heading class:list={["clip-title", { "sr-only": !entry.data.alt }]}>{entry.data.alt || "Saved image"}</Heading>
  <figure class="saved-image">
    <a href={entry.data.src} aria-label="Open full-size image"><img src={entry.data.src} alt={entry.data.alt ?? ""} width={entry.data.width} height={entry.data.height} loading="lazy" /></a>
    {entry.data.sourceUrl && <figcaption><a class="quiet-link" href={entry.data.sourceUrl} rel="noreferrer">Image source</a></figcaption>}
  </figure>
  {entry.body?.trim() && <div slot="commentary" class="clip-commentary"><EntryBody entry={entry} /></div>}
</CardShell>
