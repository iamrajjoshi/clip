---
import type { ClipEntry } from "@/lib/clips";
import CardShell from "@/components/cards/CardShell.astro";
import EntryBody from "@/components/EntryBody.astro";
import { getClipDescription, getClipSourceLabel, getClipTitle } from "@/lib/clips";

const { entry, standalone = false } = Astro.props as { entry: ClipEntry; standalone?: boolean };
if (entry.data.kind !== "link") throw new Error("LinkCard received a non-link entry.");
const title = getClipTitle(entry);
const description = getClipDescription(entry);
const Heading = standalone ? "h1" : "h2";
---

<CardShell entry={entry} standalone={standalone}>
  <div class="link-preview">
    <div class="link-copy">
      <div class="clip-source">
        {entry.data.favicon && <img class="source-icon" src={entry.data.favicon} alt="" width="16" height="16" loading="lazy" />}
        <span>{getClipSourceLabel(entry)}</span>
      </div>
      <Heading class="clip-title"><a href={entry.data.url} rel="noreferrer">{title}</a></Heading>
      {description && description !== title && <p class="clip-description">{description}</p>}
    </div>
    {entry.data.ogImage && <a class="link-thumbnail" href={entry.data.url} tabindex="-1" aria-hidden="true"><img src={entry.data.ogImage} alt="" width="112" height="84" loading="lazy" /></a>}
  </div>
  {entry.body?.trim() && <div slot="commentary" class="clip-commentary"><EntryBody entry={entry} /></div>}
</CardShell>
