{
  "name": "clip.rajjoshi.me",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "dev": "pnpm --filter @clip/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "duplicates": "pnpm dlx jscpd --config .jscpd.json",
    "knip": "knip --include dependencies,devDependencies,unlisted,binaries",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm --filter @clip/web check && pnpm --filter @clip/cli typecheck",
    "clip": "pnpm --filter @clip/cli clip",
    "install:cli": "pnpm link --global ./packages/clip-cli"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "knip": "^6.32.2",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2"
  }
}
