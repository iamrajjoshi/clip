{
  "name": "clip.rajjoshi.me",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "dev": "pnpm --filter @clip/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm --filter @clip/web check && pnpm --filter @clip/cli typecheck",
    "clip": "pnpm --filter @clip/cli clip",
    "install:cli": "pnpm link --global ./packages/clip-cli"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "astro-eslint-parser": "^3.1.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.11.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
